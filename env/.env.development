# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'development'

# 应用标题
VITE_APP_TITLE = 'Nihonnuta - 本地开发'

# 本地开发服务器端口（避免与生产环境80端口冲突）
VITE_APP_PORT = 5173

# 后台请求地址（本地开发时指向本地后端）
VITE_SERVER_BASEURL = 'http://localhost:5217'

# H5是否需要代理
VITE_APP_PROXY_ENABLE = true

# H5代理前缀
VITE_APP_PROXY_PREFIX = '/api'

# 后端是否有统一前缀 /api
VITE_SERVER_HAS_API_PREFIX = true

# 认证模式
VITE_AUTH_MODE = 'single'

# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false

# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = true

# 应用公共基础路径
VITE_APP_PUBLIC_BASE = '/'

# 是否复制原生资源
VITE_COPY_NATIVE_RES_ENABLE = false
